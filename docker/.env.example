# Copy to docker/.env (git-ignored) and fill in. Used by docker/compose.yml.

# ── Image and networking ────────────────────────────────────────────────────
AGENT_CANVAS_IMAGE=agent-canvas:local
# 127.0.0.1 = only reachable through a reverse proxy on this host (recommended).
BIND_ADDRESS=127.0.0.1
HOST_PORT=8000
# External URL users reach Canvas at (behind your proxy), e.g. https://agents.example.com
PUBLIC_URL=http://127.0.0.1:8000
# Host folder the agents write to (mounted at /projects). Each Canvas
# conversation works in its own subfolder; Telegram agents work in the root.
# On macOS, prefer a folder on the internal disk, e.g. /Users/you/OpenHands/projects.
PROJECTS_DIR=./projects
# Optional second folder, mounted at /documents (e.g. /Users/you/Documents).
# Agents can read and change everything in it, so mount only what they need.
DOCUMENTS_DIR=./documents
# true = Canvas opens already connected to this container's backend, with no
# "Add a backend" or API key screen. It embeds the session key in the page, so
# anyone who can open the page controls the agents. Keep it true only on your
# own machine (BIND_ADDRESS=127.0.0.1). Set false before exposing the port or
# putting a public reverse proxy in front.
AUTO_LOGIN=true

# ── Secrets (leave empty to auto-generate and persist in the state volume) ──
# Session key the browser and API clients use (X-Session-API-Key).
LOCAL_BACKEND_API_KEY=
# Encrypts stored settings and secrets. If you set it, never change it later.
OH_SECRET_KEY=

# ── Claude ──────────────────────────────────────────────────────────────────
# Option A, Anthropic API key: enter it in Canvas → Settings → LLM, or here.
# ANTHROPIC_API_KEY=
# Option B, Claude Pro/Max: pick the Claude Code agent in Canvas, then run once
#   docker exec -it agent-canvas claude   (then /login)
# and sign in. The login is kept in the claude-login volume.

# ── Shared memory (docs/MEMORY.md) ─────────────────────────────────────────
# Qdrant runs in compose.yml. Empty QDRANT_URL turns the memory MCP off.
# QDRANT_URL=http://qdrant:6333
# MEMORY_COLLECTION=agent-memory
# MEMORY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Store a summary of every finished conversation turn (default true).
# MEMORY_AUTO_SUMMARY=true
# Install graphify git hooks in repos under /projects, so each commit
# re-indexes the code graph (default true).
# GRAPHIFY_AUTO_HOOKS=true
# Folders scanned for those repos, comma-separated: each is a repo or holds
# repos up to 3 levels down (default /projects), e.g.
# GRAPHIFY_PROJECTS_DIR=/projects,/documents/my-app

# ── Git and pull requests (feature-branch-pr skill) ─────────────────────────
# Author for commits agents make, and a GitHub token so they can push and
# open PRs (fine-grained: Contents + Pull requests read/write on your repos).
# Or leave GH_TOKEN empty and run once:
#   docker exec -it agent-canvas gh auth login
# GIT_USER_NAME=
# GIT_USER_EMAIL=
# GH_TOKEN=

# ── Cloudflare (cloudflare-wrangler skill) ─────────────────────────────────
# API token for wrangler and Cloudflare APIs (dash.cloudflare.com → My Profile →
# API Tokens; give it only the permissions the agents need, e.g. Workers
# Scripts:Edit). Deploys still need your consent in chat.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# ── Private Docker engine for agents (docker-containers skill) ─────────────
# Runs Docker-in-Docker (privileged) so agents can build images and run
# isolated test containers without touching this host's Docker. Uncomment both:
# COMPOSE_PROFILES=docker
# AGENT_DOCKER_HOST=tcp://docker:2375

# ── Telegram bridge (optional; docs/TELEGRAM.md) ───────────────────────────
# TELEGRAM_BOT_TOKEN=
# Empty = setup mode (bot only answers /whoami).
# TELEGRAM_ALLOWED_CHAT_IDS=
# TELEGRAM_ALLOWED_USER_IDS=
# OH_AGENT_PROFILE=
# OH_WORKING_DIR=/projects

LOG_LEVEL=info
